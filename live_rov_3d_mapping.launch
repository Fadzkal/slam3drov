<?xml version="1.0"?>
<!--
  live_rov_3d_mapping.launch — BlueROV2 Live 3D Mapping (Anti-Jitter & Stabilized Odometry)
  ========================================================================================
  1. AI Monocular Depth (MiDaS ONNX): publishes dense per-frame PointCloud2
  2. Stabilized Visual Odometry with Kalman Filter:
     - Odom/FilteringStrategy = 1 (Kalman filter: menstabilkan getaran/noise sensor)
     - Odom/GuessMotion = false (memutus loop putaran/muter-muter)
     - Odom/ResetCountdown = 0 (mencegah lonjakan/teleportasi tiba-tiba)
  3. Anti-Jitter Deadband:
     - RGBD/LinearUpdate = 0.08m (8 cm)
     - RGBD/AngularUpdate = 0.15 rad (8.5 derajat)
  4. Clean Trajectory Tracker: /robot_path (neon green) & /rov/model_marker (red 3D body)
  5. RViz: PointCloud2 + MapCloud (History) + Trajectory + ROV Body + Pitch Black BG
-->
<launch>
  <arg name="camera_url" default="http://192.168.2.1:8555/video" />
  <arg name="blueos_ip" default="192.168.2.2" />

  <!-- 1. Live Camera Stream Node from BlueROV2 -->
  <include file="$(find video_stream_opencv)/launch/camera.launch">
    <arg name="camera_name" value="camera" />
    <arg name="video_stream_provider" value="$(arg camera_url)" />
    <arg name="fps" value="15" />
    <arg name="set_camera_fps" value="15" />
    <arg name="buffer_queue_size" value="1" />
    <arg name="frame_id" value="camera_optical_link" />
    <arg name="camera_info_url" value="package://subsea_3d_mapping/config/camera_info.yaml" />
  </include>

  <!-- 2. Live BlueOS Telemetry & IMU Bridge -->
  <node pkg="subsea_3d_mapping" type="blueos_live_bridge.py" name="blueos_bridge" output="screen">
    <param name="blueos_ip" type="string" value="$(arg blueos_ip)" />
    <param name="rate" type="double" value="20.0" />
    <param name="publish_tf" type="bool" value="false" />
  </node>

  <!-- 3. Coordinate Frames (Static TF) -->
  <node pkg="tf2_ros" type="static_transform_publisher" name="base_to_camera" 
        args="0.18 0.0 0.05 0 0 0 base_link camera_link" />

  <node pkg="tf2_ros" type="static_transform_publisher" name="camera_to_optical" 
        args="0 0 0 -1.5707963 0 -1.5707963 camera_link camera_optical_link" />

  <!-- Ping1D Sonar forward acoustic beam TF -->
  <node pkg="tf2_ros" type="static_transform_publisher" name="base_to_ping1d" 
        args="0.15 0.0 -0.05 0 0 0 base_link ping1d_sonar_link" />

  <!-- Bar30 Hydrostatic Pressure Sensor TF -->
  <node pkg="tf2_ros" type="static_transform_publisher" name="base_to_bar30" 
        args="0.0 0.0 -0.08 0 0 0 base_link bar30_depth_link" />

  <!-- 4. AI Monocular Depth & Synchronizer Generator (Dense AI Surface PointCloud2) -->
  <node pkg="subsea_3d_mapping" type="monocular_depth_node.py" name="monocular_depth" output="screen">
    <param name="depth_scale" value="4.5" />
    <param name="point_step" value="3" />
    <param name="image_topic" value="/camera/image_raw" />
  </node>

  <!-- 5. RTAB-Map Visual Odometry & Dense 3D Mapping -->
  <group ns="rtabmap">

    <!-- Visual Odometry: Kalman-Filtered Frame-to-Map (ANTI GERAK-GERAK SENDIRI) -->
    <node pkg="rtabmap_odom" type="rgbd_odometry" name="rgbd_odometry" output="screen">
      <param name="frame_id"                    type="string" value="base_link"/>
      <param name="odom_frame_id"               type="string" value="odom"/>
      <param name="publish_tf"                  type="bool"   value="true"/>
      <param name="approx_sync"                 type="bool"   value="true"/>
      <param name="queue_size"                  type="int"    value="10"/>
      <param name="wait_for_transform"          type="bool"   value="true"/>
      <param name="wait_for_transform_duration" type="double" value="0.5"/>

      <remap from="rgb/image"                   to="/camera/synced/image"/>
      <remap from="depth/image"                 to="/camera/synced/depth"/>
      <remap from="rgb/camera_info"             to="/camera/synced/camera_info"/>
      <remap from="odom"                        to="/rtabmap/odom"/>

      <!-- Visual Odometry: Robust Frame-to-Map with EPnP & Outlier Rejection -->
      <param name="Odom/Strategy"               type="string" value="0"/>
      <param name="Odom/Holonomic"              type="string" value="true"/>
      <param name="Odom/FilteringStrategy"      type="string" value="0"/>

      <!-- Batas Maksimum Kecepatan: MENCEGAH PETA MELAYANG / MELOMPAT (Outlier Rejection) -->
      <param name="Odom/MaxTranslation"         type="string" value="0.30"/> <!-- Maks 30 cm per frame, tolak lompatan liar -->
      <param name="Odom/MaxRotation"            type="string" value="0.50"/> <!-- Maks ~28 derajat per frame -->

      <!-- Matikan GuessMotion agar tidak ada feedback loop rotasi runaway (muter-muter) -->
      <param name="Odom/GuessMotion"            type="string" value="false"/>
      <!-- ResetCountdown = 0: Jangan auto-reset ke titik acak saat tracking drop sesaat, tunggu recovery -->
      <param name="Odom/ResetCountdown"         type="string" value="0"/>
      <param name="Odom/KeyFrameThr"            type="string" value="0.3"/>

      <!-- EPnP Motion Estimation (Closed-form, toleran skala monocular MiDaS, bebas guess) -->
      <param name="Vis/EstimationType"          type="string" value="1"/>
      <param name="Vis/PnPFlags"                type="string" value="1"/> <!-- 1 = SOLVEPNP_EPNP -->
      <param name="Vis/PnPReprojError"          type="string" value="4.0"/> <!-- Reprojection error lebih ketat -->
      <param name="Vis/MinInliers"              type="string" value="10"/> <!-- Minimal 10 inlier terverifikasi -->
      <!-- Matikan bundle adjustment gate agar tidak gagal pada inliers tipis -->
      <param name="OdomF2M/BundleAdjustment"    type="string" value="0"/>
      <param name="Vis/BundleAdjustment"        type="string" value="0"/>

      <!-- ORB Features -->
      <param name="Vis/FeatureType"             type="string" value="8"/>
      <param name="Vis/MaxFeatures"             type="string" value="1200"/>
      <param name="Vis/CorType"                 type="string" value="0"/>
      <param name="Vis/MaxDepth"                type="string" value="4.5"/>
      <param name="Vis/MinDepth"                type="string" value="0.25"/>
    </node>

    <!-- RTAB-Map SLAM Node: accumulates dense 3D map history -->
    <node name="rtabmap" pkg="rtabmap_slam" type="rtabmap" output="screen" args="--delete_db_on_start">
      <param name="frame_id"                    type="string" value="base_link"/>
      <param name="odom_frame_id"               type="string" value="odom"/>
      <param name="map_frame_id"                type="string" value="map"/>
      <param name="subscribe_depth"             type="bool"   value="true"/>
      <param name="subscribe_rgb"               type="bool"   value="false"/>
      <param name="subscribe_odom"              type="bool"   value="true"/>
      <param name="approx_sync"                 type="bool"   value="true"/>
      <param name="queue_size"                  type="int"    value="10"/>
      <param name="sync_queue_size"             type="int"    value="10"/>
      <param name="tf_tolerance"                type="double" value="0.5"/>
      <param name="wait_for_transform"          type="bool"   value="true"/>
      <param name="wait_for_transform_duration" type="double" value="0.5"/>

      <remap from="rgb/image"                   to="/camera/synced/image"/>
      <remap from="depth/image"                 to="/camera/synced/depth"/>
      <remap from="rgb/camera_info"             to="/camera/synced/camera_info"/>
      <remap from="odom"                        to="/rtabmap/odom"/>

      <!-- Visual Feature Detection -->
      <param name="RGBD/Enabled"                type="string" value="true"/>
      <param name="Kp/DetectorStrategy"         type="string" value="8"/>
      <param name="Kp/MaxFeatures"              type="string" value="800"/>
      <param name="Vis/FeatureType"             type="string" value="8"/>
      <param name="Vis/MaxFeatures"             type="string" value="800"/>
      <param name="Vis/MinInliers"              type="string" value="10"/>
      <param name="Vis/BundleAdjustment"        type="string" value="0"/>

      <!-- SLAM Rate & Synchronization -->
      <param name="Rtabmap/DetectionRate"       type="string" value="1.5"/>
      <param name="Rtabmap/TimeThr"             type="string" value="700"/>

      <!-- 3D Dense Grid / Voxelization -->
      <param name="Grid/FromDepth"              type="string" value="true"/>
      <param name="Grid/Sensor"                 type="string" value="1"/> <!-- 1 = Depth image (RGB-D) -->
      <param name="Grid/RangeMax"               type="string" value="5.0"/>
      <param name="Grid/RangeMin"               type="string" value="0.25"/>
      <param name="Grid/DepthDecimation"        type="int"    value="4"/>
      <param name="Grid/CellSize"               type="double" value="0.04"/>
      <param name="Grid/VoxelSize"              type="double" value="0.03"/>
      <param name="cloud_voxel_size"            type="double" value="0.03"/>

      <!-- KEYFRAME THRESHOLD: Simpan riwayat keyframe setiap 12cm atau 10 derajat (mencegah desync) -->
      <param name="RGBD/LinearUpdate"           type="string" value="0.12"/>
      <param name="RGBD/AngularUpdate"          type="string" value="0.18"/>
      <param name="RGBD/OptimizeFromGraphEnd"   type="string" value="false"/>

      <!-- Loop Closure Stability: Filter False Positive agar graf tidak tertarik melintir -->
      <param name="RGBD/OptimizeMaxError"       type="string" value="1.5"/>
      <param name="Rtabmap/LoopThr"             type="string" value="0.16"/>
      <param name="Mem/RehearsalSimilarity"     type="string" value="0.50"/>

      <!-- 2D / 2.5D Ground Occupancy Grid Mapping (seperti Gambar 2) -->
      <param name="RGBD/CreateOccupancyGrid"    type="string" value="true"/>
      <param name="Grid/NormalsSegmentation"    type="string" value="true"/>
      <param name="Grid/MaxGroundAngle"         type="string" value="45"/>
      <param name="Grid/MaxGroundHeight"        type="string" value="0.08"/>
      <param name="Grid/MinGroundHeight"        type="string" value="-0.08"/>

      <!-- Optimizer -->
      <param name="Optimizer/Strategy"          type="string" value="1"/>
      <param name="Optimizer/Iterations"        type="string" value="20"/>
      <param name="Optimizer/Epsilon"           type="string" value="0.00001"/>
    </node>
  </group>

  <!-- 6. ROV Trajectory Tracker (jalur /robot_path & body marker merah di RViz) -->
  <node pkg="subsea_3d_mapping" type="rov_trajectory_node.py" name="rov_trajectory_tracker" output="screen">
    <param name="max_path_length" value="10000" />
    <param name="min_step_m" value="0.04" />
  </node>

  <!-- 7. EgoExo++ 2.5D Ground Surface Estimator (bidang lantai dasar toska & lintasan kuning Gambar 2) -->
  <node pkg="subsea_3d_mapping" type="egoexo_ground_surface_node.py" name="egoexo_ground_surface" output="screen">
    <param name="padding_m" value="0.6" />
    <param name="floor_alpha" value="0.85" />
  </node>

  <!-- 8. RViz 3D Visualizer -->
  <node pkg="rviz" type="rviz" name="rviz" 
        args="-d $(find subsea_3d_mapping)/rviz/subsea_mapping.rviz" />

</launch>
