<?xml version="1.0"?>
<!--
  sim_subsea_mapping.launch — Dry-Run & Offline 3D Mapping Simulation
  ===================================================================
  Memungkinkan pengujian end-to-end 100% pipeline SLAM & visualisasi RViz
  tanpa harus mencolokkan BlueROV2 fisik.

  Menggunakan rekaman video nyata BlueROV2 (Site-113-A-Steel-Container)
  dan memprosesnya melalui CLAHE, MiDaS Depth, RTAB-Map SLAM, EKF, dan RViz!
-->
<launch>
  <arg name="video_file"
       default="/mnt/c/remote_ROV/videos/YTDown.com_YouTube_Media_g4bUv6Fx3Pk_Site-113-A-Steel-Container-from-a-BlueROV2_001_1080p.mp4"
       doc="Path ke file video MP4 BlueROV2" />
  <arg name="fps" default="20" doc="Frame rate pemutaran video" />
  <arg name="loop" default="true" doc="Loop video terus menerus" />

  <!-- 1. Video Stream Player (menggantikan kamera live ROV) -->
  <node pkg="video_stream_opencv" type="video_stream" name="rov_camera" output="screen">
    <param name="camera_name"           type="string" value="camera" />
    <param name="video_stream_provider" type="string" value="$(arg video_file)" />
    <param name="set_camera_fps"        type="double" value="$(arg fps)" />
    <param name="fps"                   type="double" value="$(arg fps)" />
    <param name="buffer_queue_size"     type="int"    value="2" />
    <param name="frame_id"              type="string" value="camera_optical_link" />
    <param name="camera_info_url"       type="string"
           value="package://subsea_3d_mapping/config/camera_info.yaml" />
    <param name="loop_videofile"        type="bool"   value="$(arg loop)" />
    <param name="flip_horizontal"       type="bool"   value="false" />
    <param name="flip_vertical"         type="bool"   value="false" />
    <remap from="/rov_camera/image_raw"    to="/camera/image_raw" />
    <remap from="/rov_camera/camera_info"  to="/camera/camera_info" />
  </node>

  <!-- 2. Static TF Transforms -->
  <node pkg="tf2_ros" type="static_transform_publisher" name="base_to_imu"
        args="0 0 0 0 0 0 base_link base_imu_link" />

  <node pkg="tf2_ros" type="static_transform_publisher" name="base_to_camera"
        args="0.18 0.0 0.05 0 0 0 base_link camera_link" />

  <node pkg="tf2_ros" type="static_transform_publisher" name="camera_to_optical"
        args="0 0 0 -1.5707963 0 -1.5707963 camera_link camera_optical_link" />

  <node pkg="tf2_ros" type="static_transform_publisher" name="base_to_ping1d"
        args="0.15 0.0 -0.05 0 0 0 base_link ping1d_sonar_link" />

  <node pkg="tf2_ros" type="static_transform_publisher" name="base_to_bar30"
        args="0.0 0.0 -0.08 0 0 0 base_link bar30_depth_link" />

  <!-- 3. CLAHE Contrast Enhancement Node -->
  <node pkg="subsea_3d_mapping" type="underwater_clahe_node.py"
        name="underwater_clahe" output="screen">
    <param name="width"  value="960" />
    <param name="height" value="540" />
  </node>

  <!-- 4. Simulated Sensor Telemetry (Bar30, Ping1D Sonar, IMU) -->
  <node pkg="subsea_3d_mapping" type="sim_telemetry_node.py"
        name="sim_telemetry" output="screen">
    <param name="rate"         value="20.0" />
    <param name="base_depth_m" value="2.3" />
    <param name="base_range_m" value="1.85" />
  </node>

  <!-- 5. Monocular AI Depth Estimator (MiDaS ONNX + Acoustic Anchor) -->
  <node pkg="subsea_3d_mapping" type="monocular_depth_node.py"
        name="monocular_depth" output="screen">
    <param name="depth_scale" value="5.0" />
    <param name="point_step"  value="4" />
  </node>

  <!-- 6. robot_localization EKF (Sensor Fusion) -->
  <node pkg="robot_localization" type="ekf_localization_node"
        name="ekf_localization" output="screen" clear_params="true">
    <rosparam command="load"
              file="$(find subsea_3d_mapping)/config/ekf_params.yaml" />
  </node>

  <!-- 7. RTAB-Map SLAM & Odometry -->
  <group ns="rtabmap">
    <!-- Visual Odometry (RGB-D) -->
    <node pkg="rtabmap_odom" type="rgbd_odometry" name="rgbd_odometry" output="screen">
      <param name="frame_id"                    type="string" value="base_link" />
      <param name="odom_frame_id"               type="string" value="odom" />
      <param name="publish_tf"                  type="bool"   value="false" />
      <param name="approx_sync"                 type="bool"   value="true" />
      <param name="queue_size"                  type="int"    value="20" />
      <param name="wait_for_transform"          type="bool"   value="true" />
      <param name="wait_for_transform_duration" type="double" value="0.5" />

      <remap from="rgb/image"                   to="/camera/synced/image" />
      <remap from="depth/image"                 to="/camera/synced/depth" />
      <remap from="rgb/camera_info"             to="/camera/synced/camera_info" />
      <remap from="odom"                        to="/rtabmap/odom" />

      <param name="Odom/Strategy"               type="string" value="0" />
      <param name="Odom/Holonomic"              type="string" value="true" />
      <param name="Odom/ResetCountdown"         type="string" value="1" />
      <param name="Odom/KeyFrameThr"            type="string" value="0.3" />
      <param name="Vis/FeatureType"             type="string" value="8" />
      <param name="Vis/MaxFeatures"             type="string" value="800" />
      <param name="Vis/MinInliers"              type="string" value="7" />
      <param name="Vis/CorType"                 type="string" value="0" />
    </node>

    <!-- RTAB-Map SLAM Node -->
    <node name="rtabmap" pkg="rtabmap_slam" type="rtabmap"
          output="screen" args="--delete_db_on_start">
      <param name="frame_id"        type="string" value="base_link" />
      <param name="odom_frame_id"   type="string" value="odom" />
      <param name="map_frame_id"    type="string" value="map" />

      <param name="subscribe_odom"   type="bool" value="true" />
      <param name="subscribe_depth"  type="bool" value="true" />
      <param name="subscribe_rgb"    type="bool" value="false" />
      <param name="subscribe_scan"   type="bool" value="false" />

      <param name="approx_sync"      type="bool" value="true" />
      <param name="queue_size"       type="int"  value="20" />
      <param name="sync_queue_size"  type="int"  value="20" />
      <param name="tf_tolerance"     type="double" value="0.5" />

      <remap from="rgb/image"         to="/camera/synced/image" />
      <remap from="depth/image"       to="/camera/synced/depth" />
      <remap from="rgb/camera_info"   to="/camera/synced/camera_info" />
      <remap from="odom"              to="/odometry/filtered" />

      <param name="Kp/DetectorStrategy"    type="string" value="8" />
      <param name="Kp/MaxFeatures"         type="string" value="800" />
      <param name="Vis/MinInliers"         type="string" value="8" />
      <param name="Vis/FeatureType"        type="string" value="8" />
      <param name="Vis/CorType"            type="string" value="0" />
      <param name="Vis/MaxFeatures"        type="string" value="600" />

      <param name="Rtabmap/DetectionRate"  type="string" value="1.0" />
      <param name="Rtabmap/TimeThr"        type="string" value="700" />

      <param name="Grid/FromDepth"         type="string" value="true" />
      <param name="Grid/RangeMin"          type="string" value="0.3" />
      <param name="Grid/RangeMax"          type="string" value="5.5" />
      <param name="cloud_voxel_size"       type="double" value="0.02" />

      <param name="RGBD/Enabled"           type="string" value="true" />
      <param name="RGBD/LinearUpdate"      type="string" value="0.05" />
      <param name="RGBD/AngularUpdate"     type="string" value="0.05" />
      <param name="RGBD/OptimizeFromGraphEnd" type="string" value="false" />
      <param name="RGBD/CreateOccupancyGrid"  type="string" value="true" />

      <param name="Mem/RehearsalSimilarity" type="string" value="0.45" />
      <param name="Rtabmap/LoopThr"         type="string" value="0.11" />
    </node>
  </group>

  <!-- 8. ROV Trajectory Tracker -->
  <node pkg="subsea_3d_mapping" type="rov_trajectory_node.py"
        name="rov_trajectory_tracker" output="screen">
    <param name="max_path_length" value="8000" />
    <param name="min_step_m"      value="0.015" />
  </node>

  <!-- 9. RViz Visualizer -->
  <node pkg="rviz" type="rviz" name="rviz"
        args="-d $(find subsea_3d_mapping)/rviz/subsea_mapping.rviz" />

</launch>
