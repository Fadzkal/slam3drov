Panels:
  - Class: rviz/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /RTAB-Map 3D Cloud1
        - /Robot Trajectory1
        - /Ping1D Range1
        - /EKF Odometry1
      Splitter Ratio: 0.48
    Tree Height: 700
  - Class: rviz/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
  - Class: rviz/Time
    Experimental: false
    Name: Time
    SyncMode: 0
    SyncSource: ""
Visualization Manager:
  Class: ""
  Displays:
    # -----------------------------------------------------------------------
    # Ground Grid (1m squares)
    # -----------------------------------------------------------------------
    - Alpha: 0.4
      Cell Size: 1
      Class: rviz/Grid
      Color: 30; 80; 120
      Enabled: true
      Line Style:
        Line Width: 0.02
        Value: Lines
      Name: Grid 1m
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 20
      Reference Frame: map
      Value: true

    # -----------------------------------------------------------------------
    # TF Frames (camera, base_link, ping1d, bar30, odom, map)
    # -----------------------------------------------------------------------
    - Class: rviz/TF
      Enabled: true
      Frame Timeout: 15
      Frames:
        All Enabled: false
        base_link:
          Value: true
        camera_link:
          Value: true
        camera_optical_link:
          Value: false
        ping1d_sonar_link:
          Value: true
        bar30_depth_link:
          Value: false
        odom:
          Value: true
        map:
          Value: true
      Marker Scale: 0.6
      Name: TF Frames
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Update Interval: 0
      Value: true

    # -----------------------------------------------------------------------
    # Live Camera Feed (raw from BlueROV2)
    # -----------------------------------------------------------------------
    - Class: rviz/Image
      Enabled: true
      Image Topic: /camera/image_raw
      Max Value: 1
      Median window: 5
      Min Value: 0
      Name: Camera ROV (Raw)
      Normalize Range: false
      Queue Size: 2
      Transport Hint: raw
      Unreliable: false
      Value: true

    # -----------------------------------------------------------------------
    # RTAB-Map Dense 3D Point Cloud Map (MapCloud plugin – accumulates over time)
    # -----------------------------------------------------------------------
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: -10
        Value: true
      Axis: Z
      Channel Name: rgb
      Class: rtabmap_rviz_plugins/MapCloud
      Cloud decimation: 8
      Cloud max depth (m): 6.0
      Cloud min depth (m): 0.35
      Cloud voxel size (m): 0.07
      Color: 255; 255; 255
      Color Transformer: RGB8
      Download graph: true
      Download map: true
      Enabled: true
      Filter ceiling (m): 0
      Filter floor (m): 0
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Max Intensity: 4096
      Min Color: 0; 0; 0
      Min Intensity: 0
      Name: RTAB-Map 3D Cloud
      Node filtering angle (degrees): 20
      Node filtering radius (m): 0.25
      Position Transformer: XYZ
      Size (Pixels): 2
      Size (m): 0.02
      Style: Points
      Topic: /rtabmap/mapData
      Unreliable: false
      Use Fixed Frame: true
      Use rainbow: false
      Value: true

    # -----------------------------------------------------------------------
    # RTAB-Map Graph (pose graph, loop closures, keyframes)
    # -----------------------------------------------------------------------
    - Alpha: 1
      Class: rtabmap_rviz_plugins/MapGraph
      Enabled: true
      Global loop closure: 255; 0; 0
      Local loop closure: 255; 255; 0
      Merged neighbor: 255; 170; 0
      Name: Pose Graph
      Neighbor: 0; 100; 255
      Topic: /rtabmap/mapGraph
      Unreliable: false
      User: 255; 0; 0
      Value: true
      Virtual: 255; 0; 255

    # -----------------------------------------------------------------------
    # RTAB-Map Stats (memory, loop closure status, FPS)
    # -----------------------------------------------------------------------
    - Class: rtabmap_rviz_plugins/Info
      Enabled: true
      Name: RTAB-Map Info
      Topic: /rtabmap/info
      Unreliable: false
      Value: true

    # -----------------------------------------------------------------------
    # ROV 6-DoF Trajectory Path
    # -----------------------------------------------------------------------
    - Alpha: 1
      Buffer Length: 10000
      Class: rviz/Path
      Color: 0; 255; 255
      Enabled: true
      Head Diameter: 0.15
      Head Length: 0.1
      Length: 0.1
      Line Style: Lines
      Line Width: 0.04
      Name: Robot Trajectory
      Offset:
        X: 0
        Y: 0
        Z: 0
      Pose Color: 255; 85; 0
      Pose Style: Arrows
      Radius: 0.02
      Shaft Diameter: 0.05
      Shaft Length: 0.05
      Topic: /robot_path
      Unreliable: false
      Value: true

    # -----------------------------------------------------------------------
    # ROV 3D Body Orientation Marker
    # -----------------------------------------------------------------------
    - Class: rviz/Marker
      Enabled: true
      Marker Topic: /rov/model_marker
      Name: ROV 3D Body
      Queue Size: 10
      Unreliable: false
      Value: true

    # -----------------------------------------------------------------------
    # EKF Fused Odometry (position + orientation from robot_localization)
    # -----------------------------------------------------------------------
    - Class: rviz/Odometry
      Angle Tolerance: 0.1
      Covariance:
        Orientation:
          Alpha: 0.5
          Color: 255; 255; 127
          Color Style: Unique
          Frame: Local
          Offset: 1
          Scale: 1
          Value: true
        Position:
          Alpha: 0.3
          Color: 204; 51; 204
          Scale: 1
          Value: true
        Value: true
      Enabled: true
      Keep: 1
      Name: EKF Odometry
      Position Tolerance: 0.1
      Shape:
        Alpha: 1
        Axes Length: 0.6
        Axes Radius: 0.04
        Color: 255; 25; 0
        Head Length: 0.3
        Head Radius: 0.1
        Shaft Length: 1
        Shaft Radius: 0.05
        Value: Arrow
      Topic: /odometry/filtered
      Unreliable: false
      Value: true

    # -----------------------------------------------------------------------
    # Ping1D Sonar Range (rendered as a cone/ring in RViz)
    # -----------------------------------------------------------------------
    - Class: rviz/Range
      Buffer Length: 1
      Color: 0; 229; 255
      Enabled: true
      Name: Ping1D Range
      Queue Size: 5
      Topic: /sonar/ping1d/range
      Unreliable: false
      Value: true

    # -----------------------------------------------------------------------
    # Real-time Depth Cloud from monocular AI depth map
    # -----------------------------------------------------------------------
    - Alpha: 0.8
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 6.0
        Min Value: 0.3
        Value: true
      Axis: Z
      Channel Name: rgb
      Class: rviz/PointCloud2
      Color: 200; 200; 200
      Color Transformer: RGB8
      Decay Time: 0.3
      Enabled: false
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Min Color: 0; 0; 0
      Name: AI Depth PointCloud (per frame)
      Position Transformer: XYZ
      Queue Size: 5
      Size (Pixels): 2
      Size (m): 0.008
      Style: Points
      Topic: /camera/depth/points
      Unreliable: false
      Use Fixed Frame: true
      Use rainbow: true
      Value: false

    # -----------------------------------------------------------------------
    # RTAB-Map Occupancy Grid (3D→2D floor projection, useful for navigation)
    # -----------------------------------------------------------------------
    - Alpha: 0.65
      Class: rviz/Map
      Color Scheme: map
      Draw Behind: false
      Enabled: false
      Name: Occupancy Grid
      Topic: /rtabmap/octomap_grid
      Unreliable: false
      Use Timestamp: false
      Value: false

  Enabled: true
  Global Options:
    Background Color: 5; 8; 17
    Default Light: true
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
      Hide Inactive Objects: true
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/Measure
  Value: true
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 8.0
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Focal Point:
        X: 0.0
        Y: 0.0
        Z: 0.0
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.45
      Target Frame: map
      Value: Orbit (rviz)
      Yaw: 0.785
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Hide Left Dock: false
  Hide Right Dock: false
  Image:
    collapsed: false
  Width: 1400
  X: 0
  Y: 0
