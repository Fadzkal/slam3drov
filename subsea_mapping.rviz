Panels:
  - Class: rviz/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /RTAB-Map 3D Cloud1
      Splitter Ratio: 0.48
    Tree Height: 700
  - Class: rviz/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
  - Class: rviz/Time
    Experimental: false
    Name: Time
    SyncMode: 0
    SyncSource: ""
Visualization Manager:
  Class: ""
  Displays:
    # -----------------------------------------------------------------------
    # Ground Grid (1m squares)
    # -----------------------------------------------------------------------
    - Alpha: 0.4
      Cell Size: 1
      Class: rviz/Grid
      Color: 30; 80; 120
      Enabled: true
      Line Style:
        Line Width: 0.02
        Value: Lines
      Name: Grid 1m
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 20
      Reference Frame: map
      Value: true

    # -----------------------------------------------------------------------
    # TF Frames (minimal: base_link + camera_link only)
    # -----------------------------------------------------------------------
    - Class: rviz/TF
      Enabled: true
      Frame Timeout: 15
      Frames:
        All Enabled: false
        base_link:
          Value: true
        camera_link:
          Value: true
        camera_optical_link:
          Value: false
        ping1d_sonar_link:
          Value: false
        bar30_depth_link:
          Value: false
        odom:
          Value: false
        map:
          Value: false
      Marker Scale: 0.5
      Name: TF Frames
      Show Arrows: false
      Show Axes: true
      Show Names: true
      Update Interval: 0
      Value: true

    # -----------------------------------------------------------------------
    # Live Camera Feed (raw from BlueROV2)
    # -----------------------------------------------------------------------
    - Class: rviz/Image
      Enabled: true
      Image Topic: /camera/image_raw
      Max Value: 1
      Median window: 5
      Min Value: 0
      Name: Camera ROV (Raw)
      Normalize Range: false
      Queue Size: 2
      Transport Hint: raw
      Unreliable: false
      Value: true

    # -----------------------------------------------------------------------
    # RTAB-Map Dense 3D Point Cloud Map (MapCloud plugin)
    # PERBAIKAN: cloud decimation NAIK, voxel BESAR → anti lag
    # -----------------------------------------------------------------------
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: -10
        Value: true
      Axis: Z
      Channel Name: rgb
      Class: rtabmap_rviz_plugins/MapCloud
      Cloud decimation: 16
      Cloud max depth (m): 4.0
      Cloud min depth (m): 0.4
      Cloud voxel size (m): 0.10
      Color: 255; 255; 255
      Color Transformer: RGB8
      Download graph: true
      Download map: true
      Enabled: true
      Filter ceiling (m): 0
      Filter floor (m): 0
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Max Intensity: 4096
      Min Color: 0; 0; 0
      Min Intensity: 0
      Name: RTAB-Map 3D Cloud
      Node filtering angle (degrees): 30
      Node filtering radius (m): 0.30
      Position Transformer: XYZ
      Size (Pixels): 2
      Size (m): 0.02
      Style: Points
      Topic: /rtabmap/mapData
      Unreliable: false
      Use Fixed Frame: true
      Use rainbow: false
      Value: true

    # -----------------------------------------------------------------------
    # RTAB-Map Graph (pose graph, loop closures)
    # -----------------------------------------------------------------------
    - Alpha: 1
      Class: rtabmap_rviz_plugins/MapGraph
      Enabled: true
      Global loop closure: 255; 0; 0
      Local loop closure: 255; 255; 0
      Merged neighbor: 255; 170; 0
      Name: Pose Graph
      Neighbor: 0; 100; 255
      Topic: /rtabmap/mapGraph
      Unreliable: false
      User: 255; 0; 0
      Value: true
      Virtual: 255; 0; 255

    # -----------------------------------------------------------------------
    # RTAB-Map Info (status monitor)
    # -----------------------------------------------------------------------
    - Class: rtabmap_rviz_plugins/Info
      Enabled: true
      Name: RTAB-Map Info
      Topic: /rtabmap/info
      Unreliable: false
      Value: true

  Enabled: true
  Global Options:
    Background Color: 5; 8; 17
    Default Light: true
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
      Hide Inactive Objects: true
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/Measure
  Value: true
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 8.0
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Focal Point:
        X: 0.0
        Y: 0.0
        Z: 0.0
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.45
      Target Frame: map
      Value: Orbit (rviz)
      Yaw: 0.785
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Hide Left Dock: false
  Hide Right Dock: false
  Image:
    collapsed: false
  Width: 1400
  X: 0
  Y: 0
