Panels:
  - Class: rviz/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /MapCloud1
        - /Robot Trajectory1
      Splitter Ratio: 0.48
    Tree Height: 700
  - Class: rviz/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
  - Class: rviz/Time
    Experimental: false
    Name: Time
    SyncMode: 0
    SyncSource: ""
Visualization Manager:
  Class: ""
  Displays:
    # -----------------------------------------------------------------------
    # 1. Grid
    # -----------------------------------------------------------------------
    - Alpha: 0.4
      Cell Size: 1
      Class: rviz/Grid
      Color: 50; 90; 130
      Enabled: true
      Line Style:
        Line Width: 0.02
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 20
      Reference Frame: map
      Value: true

    # -----------------------------------------------------------------------
    # 2. PointCloud2 (Real-Time AI Dense Depth Cloud from MiDaS ONNX)
    # Visual permukaan 3D real-time tepat di depan lensa kamera
    # -----------------------------------------------------------------------
    - Alpha: 1.0
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 5.0
        Min Value: 0.25
        Value: true
      Axis: Z
      Channel Name: rgb
      Class: rviz/PointCloud2
      Color: 255; 255; 255
      Color Transformer: RGB8
      Decay Time: 0.0
      Enabled: true
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Min Color: 0; 0; 0
      Name: PointCloud2
      Position Transformer: XYZ
      Queue Size: 5
      Selectable: true
      Size (Pixels): 2
      Size (m): 0.008
      Style: Points
      Topic: /camera/depth/points
      Unreliable: false
      Use Fixed Frame: true
      Use rainbow: false
      Value: true

    # -----------------------------------------------------------------------
    # 3. TF Frames (Disabled by default to avoid visual clutter)
    # -----------------------------------------------------------------------
    - Class: rviz/TF
      Enabled: false
      Frame Timeout: 15
      Frames:
        All Enabled: false
        base_link:
          Value: false
        camera_link:
          Value: false
        camera_optical_link:
          Value: false
        ping1d_sonar_link:
          Value: false
        bar30_depth_link:
          Value: false
        odom:
          Value: false
        map:
          Value: false
      Marker Scale: 0.2
      Name: TF
      Show Arrows: false
      Show Axes: false
      Show Names: false
      Update Interval: 0
      Value: false

    # -----------------------------------------------------------------------
    # 4. Live Camera ROV Feed
    # -----------------------------------------------------------------------
    - Class: rviz/Image
      Enabled: true
      Image Topic: /camera/image_raw
      Max Value: 1
      Median window: 5
      Min Value: 0
      Name: Image
      Normalize Range: false
      Queue Size: 2
      Transport Hint: raw
      Unreliable: false
      Value: true

    # -----------------------------------------------------------------------
    # 5. RTAB-Map MapCloud (PETA RIWAYAT 3D YANG TERTINGGAL DI BELAKANG ROV)
    # Akumulasi seluruh frame masa lalu saat ROV bergerak maju (Ground Surface)
    # -----------------------------------------------------------------------
    - Alpha: 1.0
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: -10
        Value: true
      Axis: Z
      Channel Name: rgb
      Class: rtabmap_rviz_plugins/MapCloud
      Cloud decimation: 4
      Cloud max depth (m): 5.0
      Cloud min depth (m): 0.25
      Cloud voxel size (m): 0.03
      Color: 255; 255; 255
      Color Transformer: RGB8
      Download graph: true
      Download map: true
      Enabled: true
      Filter ceiling (m): 0
      Filter floor (m): 0
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Max Intensity: 4096
      Min Color: 0; 0; 0
      Min Intensity: 0
      Name: MapCloud
      Node filtering angle (degrees): 20
      Node filtering radius (m): 0.04
      Position Transformer: XYZ
      Size (Pixels): 2
      Size (m): 0.015
      Style: Points
      Topic: /rtabmap/mapData
      Unreliable: false
      Use Fixed Frame: true
      Use rainbow: false
      Value: true

    # -----------------------------------------------------------------------
    # 6. Robot Trajectory (Jalur Hijau Terang ROV)
    # -----------------------------------------------------------------------
    - Alpha: 1.0
      Buffer Length: 10000
      Class: rviz/Path
      Color: 0; 255; 0
      Enabled: true
      Head Diameter: 0.15
      Head Length: 0.1
      Length: 0.1
      Line Style: Lines
      Line Width: 0.03
      Name: Robot Trajectory
      Offset:
        X: 0
        Y: 0
        Z: 0
      Pose Color: 0; 255; 255
      Pose Style: None
      Radius: 0.02
      Shaft Diameter: 0.05
      Shaft Length: 0.05
      Topic: /robot_path
      Unreliable: false
      Value: true

    # -----------------------------------------------------------------------
    # 7. ROV 3D Body (Model Fisik BlueROV2 Merah seperti di EgoExo++)
    # -----------------------------------------------------------------------
    - Class: rviz/Marker
      Enabled: true
      Marker Topic: /rov/model_marker
      Name: ROV 3D Body
      Queue Size: 10
      Unreliable: false
      Value: true

    # -----------------------------------------------------------------------
    # 8. Global 3D Map (Cloud Map penuh - default off agar hemat memori)
    # -----------------------------------------------------------------------
    - Alpha: 1.0
      Class: rviz/PointCloud2
      Color Transformer: RGB8
      Decay Time: 0
      Enabled: false
      Name: Global 3D Map
      Position Transformer: XYZ
      Queue Size: 2
      Selectable: false
      Size (Pixels): 2
      Style: Points
      Topic: /rtabmap/cloud_map
      Unreliable: false
      Value: false

    # -----------------------------------------------------------------------
    # 9. RTAB-Map Info (Monitor Loop Closure & Memory)
    # -----------------------------------------------------------------------
    - Class: rtabmap_rviz_plugins/Info
      Enabled: true
      Name: Info
      Topic: /rtabmap/info
      Unreliable: false
      Value: true

    # -----------------------------------------------------------------------
    # 10. RTAB-Map Graph (Pose Graph & Loop Closure Connections)
    # -----------------------------------------------------------------------
    - Alpha: 1.0
      Class: rtabmap_rviz_plugins/MapGraph
      Enabled: true
      Global loop closure: 255; 0; 0
      Local loop closure: 255; 255; 0
      Merged neighbor: 255; 170; 0
      Name: MapGraph
      Neighbor: 0; 100; 255
      Topic: /rtabmap/mapGraph
      Unreliable: false
      User: 255; 0; 0
      Value: true
      Virtual: 255; 0; 255

    # -----------------------------------------------------------------------
    # 11. Map (Occupancy Grid - default off)
    # -----------------------------------------------------------------------
    - Alpha: 0.65
      Class: rviz/Map
      Color Scheme: map
      Draw Behind: false
      Enabled: false
      Name: Map
      Topic: /rtabmap/grid_map
      Unreliable: false
      Use Timestamp: false
      Value: false

  Enabled: true
  Global Options:
    Background Color: 0; 0; 0
    Default Light: true
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
      Hide Inactive Objects: true
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/Measure
  Value: true
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 3.5
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Focal Point:
        X: 0.8
        Y: 0.0
        Z: 0.0
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.22
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz)
      Yaw: 3.14
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Hide Left Dock: false
  Hide Right Dock: false
  Image:
    collapsed: false
  Width: 1400
  X: 0
  Y: 0
