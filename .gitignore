# BlueROV2 3D SLAM Git Ignore

# External Repositories / Submodules
cockpit/

# Python artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.env
venv/
env/

# Large media files (videos)
videos/
*.mp4
*.avi
*.mkv
*.mov

# Databases & large dumps
*.db
*.db-journal

# Office & OS temp locks
~$*
* copy.*
Thumbs.db
Desktop.ini
.DS_Store

# Logs & temp
*.log
bridge_port.txt
scratch/
test_clone/
.vscode/
.idea/

# Root runtime copies (tracked models reside in export/)
/subsea_3d_map.ply
/subsea_3d_mesh.ply
/KeyFrameMapPoints.ply
/KeyFrameTrajectory.txt
export/*_cloud.ply
export/*_mesh_mesh.ply
