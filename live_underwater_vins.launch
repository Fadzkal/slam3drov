<launch>
    <!-- VINS config path -->
    <arg name="config_path" default="$(find feature_tracker)/../config/bluerov2/bluerov2_config.yaml" />
    <arg name="vins_path" default="$(find feature_tracker)/../config/../" />

    <arg name="camera_url" default="http://192.168.2.1:8555/video" />

    <!-- 1. Video Stream Node from BlueROV2 Relay (180 deg rotated stream) -->
    <node pkg="video_stream_opencv" type="video_stream" name="camera_stream" output="screen">
        <param name="camera_name" value="camera" />
        <param name="video_stream_provider" value="$(arg camera_url)" />
        <param name="fps" value="25" />
        <param name="frame_id" value="camera_optical_frame" />
        <param name="camera_info_url" value="" />
        <param name="flip_horizontal" value="false" />
        <param name="flip_vertical" value="false" />
        <param name="visualize" value="false" />
        <remap from="image_raw" to="/camera/image_raw" />
        <remap from="/image_raw" to="/camera/image_raw" />
        <remap from="camera_info" to="/camera/camera_info" />
        <remap from="/camera_info" to="/camera/camera_info" />
    </node>

    <!-- 2. Underwater CLAHE Contrast Enhancement Node (Paper SVIn2 - IEEE IROS) -->
    <node pkg="subsea_3d_mapping" type="underwater_clahe_node.py" name="underwater_clahe" output="screen">
        <param name="width" value="960" />
        <param name="height" value="540" />
    </node>

    <!-- 3. BlueOS Live MAVLink Telemetry Bridge (IMU: linear_accel + angular_velocity) -->
    <node pkg="subsea_3d_mapping" type="blueos_live_bridge.py" name="blueos_bridge" output="screen">
        <param name="blueos_ip" value="192.168.2.2" />
        <param name="rate" value="30.0" />
        <param name="publish_tf" value="false" />
    </node>

    <!-- 4. VINS-Mono Feature Tracker -->
    <node name="feature_tracker" pkg="feature_tracker" type="feature_tracker" output="screen">
        <param name="config_file" type="string" value="$(arg config_path)" />
        <param name="vins_folder" type="string" value="$(arg vins_path)" />
    </node>

    <!-- 5. VINS-Mono Estimator (Visual-Inertial State Estimator & 3D Mapping) -->
    <node name="vins_estimator" pkg="vins_estimator" type="vins_estimator" output="screen">
        <param name="config_file" type="string" value="$(arg config_path)" />
        <param name="vins_folder" type="string" value="$(arg vins_path)" />
    </node>

    <!-- 6. VINS-Mono Pose Graph & Loop Closure -->
    <node name="pose_graph" pkg="pose_graph" type="pose_graph" output="screen">
        <param name="config_file" type="string" value="$(arg config_path)" />
        <param name="visualization_shift_x" type="int" value="0" />
        <param name="visualization_shift_y" type="int" value="0" />
        <param name="skip_cnt" type="int" value="0" />
        <param name="skip_dis" type="double" value="0" />
    </node>

    <!-- 7. RViz Visualization (Official VINS-Mono RViz Configuration) -->
    <node name="rvizvisualisation" pkg="rviz" type="rviz" output="log" 
          args="-d $(find pose_graph)/../config/vins_rviz_config.rviz" />

</launch>
